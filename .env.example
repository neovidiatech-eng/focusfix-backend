# Server
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000

# CORS Whitelist (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://focusfix.net,https://admin.focusfix.net

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/focusfix?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT Auth
JWT_ACCESS_SECRET=your_jwt_access_secret_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production

# Web Revalidation Secret
REVALIDATE_SECRET=your_revalidate_secret_key
WEB_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=FocusFix Support <support@focusfix.net>
ADMIN_NOTIFICATION_EMAILS=admin@focusfix.net

# Turnstile
TURNSTILE_SECRET_KEY=0x4AAAAAA...
